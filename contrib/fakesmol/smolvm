#!/bin/sh
# fake smolvm for hub testing on a host without /dev/kvm.
#
# The "guest" of every machine is this host itself: `machine exec` runs the
# guest argv locally, `machine cp` copies locally, and machine state is a
# file per name under $FAKESMOL_DIR. It answers exactly the invocations
# internal/backend/smol.go makes (ls --json, status, create, start, stop,
# delete, cp, exec, exec -d — the detached form ensureTmux uses for the
# tmux keeper — and update --label/--remove-label, the by-hand labelling of
# a VM as devvm's) and nothing else. Everything devvm layers on top (the agent
# exec, yamux forwards, the browser shim, tmux) is real.
set -eu

dir="${FAKESMOL_DIR:-$HOME/.local/share/fakesmol}"
mkdir -p "$dir"
log="$dir/calls.log"
printf '%s smolvm' "$(date +%H:%M:%S)" >>"$log"; printf ' %s' "$@" >>"$log"; echo >>"$log"

[ "${1:-}" = "machine" ] || { echo "fake smolvm: only 'machine' is supported" >&2; exit 2; }
shift
sub="${1:-}"; [ $# -gt 0 ] && shift

state_of() { cat "$dir/$1.state" 2>/dev/null || echo "not created"; }

# flag parsing shared by every subcommand that takes --name
name=""; tty=0; envs=""; detached=0; cpus=4; mem=8192; storage=10; image=""; labels=""; unlabels=""
while [ $# -gt 0 ]; do
    case "$1" in
        --name|-n) name="$2"; shift 2 ;;
        --) shift; break ;;
        -i|--stream|--net|--force|-f|--json) shift ;;
        -it) tty=1; shift ;;
        -d) detached=1; shift ;;
        -e) envs="$envs $2"; shift 2 ;;
        --cpus) cpus="$2"; shift 2 ;;
        --mem) mem="$2"; shift 2 ;;
        --storage) storage="$2"; shift 2 ;;
        --image|-I) image="$2"; shift 2 ;;
        --env) shift 2 ;;
        --label) labels="$labels $2"; shift 2 ;;
        --remove-label) unlabels="$unlabels $2"; shift 2 ;;
        *) break ;;
    esac
done

# The real `ls --json` row carries created_at (Unix seconds), sizes, the
# pid and labels; created_at must never change for a machine's lifetime
# (devvm no longer reads it). A machine made before this fake recorded one is
# dated once, from its state file's mtime, and that date is persisted: start,
# stop and exec rewrite the state file, so the mtime itself would drift.
created_of() {
    if [ ! -e "$dir/$1.created" ]; then
        { stat -c %Y "$dir/$1.state" 2>/dev/null || stat -f %m "$dir/$1.state"; } >"$dir/$1.created"
    fi
    cat "$dir/$1.created"
}
meta_of() { cat "$dir/$1.meta" 2>/dev/null || echo "4 8192 10 ubuntu:24.04"; }

# Labels are one KEY=VALUE per line in $dir/NAME.labels; ls prints them as
# the real one does, an object of strings ({} when none). devvm owns only
# the VMs labelled devvm=true (its create passes --label devvm=true).
labels_of() {
    printf '{'
    sep=
    while IFS='=' read -r k v; do
        [ -n "$k" ] || continue
        printf '%s"%s":"%s"' "$sep" "$k" "$v"
        sep=,
    done 2>/dev/null <"$dir/$1.labels" || true
    printf '}'
}
set_labels() { # NAME, then KEY=VALUE words to set (replacing a key)
    n=$1; shift
    for kv in "$@"; do
        { grep -v "^${kv%%=*}=" "$dir/$n.labels" 2>/dev/null || true; echo "$kv"; } >"$dir/$n.labels.new"
        mv "$dir/$n.labels.new" "$dir/$n.labels"
    done
}

case "$sub" in
    ls)
        printf '['
        first=1
        for f in "$dir"/*.state; do
            [ -e "$f" ] || continue
            n=$(basename "$f" .state)
            [ $first = 1 ] || printf ','
            first=0
            set -- $(meta_of "$n")
            st=$(cat "$f"); pid=null; [ "$st" = running ] && pid=$$
            printf '{"name":"%s","state":"%s","created_at":%s,"cpus":%s,"memory_mib":%s,"storage_gb":%s,"image":"%s","pid":%s,"labels":%s}' \
                "$n" "$st" "$(created_of "$n")" "$1" "$2" "$3" "$4" "$pid" "$(labels_of "$n")"
        done
        printf ']\n'
        ;;
    status)
        [ -e "$dir/$name.state" ]
        ;;
    create)
        [ -e "$dir/$name.state" ] && { echo "fake smolvm: $name exists" >&2; exit 1; }
        echo stopped >"$dir/$name.state"
        date +%s >"$dir/$name.created"
        echo "$cpus $mem $storage ${image:-ubuntu:24.04}" >"$dir/$name.meta"
        : >"$dir/$name.labels"
        set_labels "$name" $labels
        ;;
    update)
        # Labels only (the one update devvm's by-hand step needs); they
        # change on a running machine too, as on smolvm 1.35.5.
        [ -e "$dir/$name.state" ] || { echo "fake smolvm: no machine $name" >&2; exit 1; }
        set_labels "$name" $labels
        for k in $unlabels; do
            { grep -v "^$k=" "$dir/$name.labels" 2>/dev/null || true; } >"$dir/$name.labels.new"
            mv "$dir/$name.labels.new" "$dir/$name.labels"
        done
        ;;
    start)
        [ -e "$dir/$name.state" ] || { echo "fake smolvm: no machine $name" >&2; exit 1; }
        echo running >"$dir/$name.state"
        ;;
    stop)
        [ -e "$dir/$name.state" ] || { echo "fake smolvm: no machine $name" >&2; exit 1; }
        echo stopped >"$dir/$name.state"
        ;;
    delete|rm)
        rm -f "$dir/$name.state" "$dir/$name.created" "$dir/$name.meta" "$dir/$name.labels"
        ;;
    cp)
        # smolvm machine cp SRC NAME:DST — root-owned like the real thing.
        # NAME:SRC DST downloads (read as root, written as the caller).
        # Keyed on $2 first: an upload's host source may itself hold a ':'.
        # NAME:… is a ':' not preceded by a '/' (devvm's host paths are
        # absolute, machine names never hold one).
        case "$2" in
            [!/]*:*) sudo cp -a "$1" "${2#*:}" ;;
            *) case "$1" in
                   [!/]*:*) sudo cat -- "${1#*:}" >"$2" ;;
                   *) echo "fake smolvm: cp needs NAME: on one side" >&2; exit 2 ;;
               esac ;;
        esac
        ;;
    exec)
        # `smolvm machine exec` boots a stopped VM; devvm relies on that in
        # places and guards against it in others. Mirror it: exec starts the
        # machine if it exists, refuses if it does not.
        [ -e "$dir/$name.state" ] || { echo "fake smolvm: no machine $name" >&2; exit 1; }
        echo running >"$dir/$name.state"
        for e in $envs; do export "$e"; done
        # Real smolvm enters the guest as root; devvm's guestArgv drops to
        # the user itself with `sudo -u USER`. Enter as root here too so
        # root-only work (prereqs, /usr/local/bin agent install) behaves.
        if [ "$detached" = 1 ]; then
            # -d: return at once and let the command outlive this call with
            # its stdio on /dev/null, as the real detached exec does (the
            # tmux keeper must survive `attach` coming and going). setsid
            # when present (util-linux and busybox both have it) so it also
            # leaves the caller's session; nohup alone otherwise.
            run="sudo -n --preserve-env=TERM,SMOLVM_GUEST --"
            if command -v setsid >/dev/null 2>&1; then run="setsid $run"; fi
            nohup $run "$@" </dev/null >/dev/null 2>&1 &
            exit 0
        fi
        exec sudo -n --preserve-env=TERM,SMOLVM_GUEST -- "$@"
        ;;
    *)
        echo "fake smolvm: unsupported: machine $sub" >&2; exit 2 ;;
esac
